# Copy to .dev.vars for `wrangler dev`. Never commit .dev.vars - it's gitignored.
# In production these four are set with `wrangler secret put <NAME>` instead.
AbillitySystemInformation = "<YOUR_SYSTEM_INFORMATION>"
AbillityUserName = "<YOUR_ABILLITY_USERNAME>"
AbillityPassword = "<YOUR_ABILLITY_PASSWORD>"
WebhookToken = "<A_LONG_RANDOM_STRING>"

# Also readable from wrangler.toml [vars] - override here for local testing.
AutotaskAbillityIdUdfLabel = "aBillity Company ID"
AutotaskSyncFlagUdfLabel = "Sync with aBillity (yes or no)"
